# build artifacts, secrets, dependencies, and caches.
# Unauthorized reproduction is prohibited.

# ==========================================
# BUILD OUTPUT
# ==========================================
.next/
out/
build/
dist/
*.tsbuildinfo
tsconfig.tsbuildinfo

# ==========================================
# DEPENDENCIES
# ==========================================
node_modules/
.pnp
.pnp.js

# ==========================================
# ENVIRONMENT & SECRETS
# NEVER commit these files
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Supabase local
supabase/.temp/
supabase/.env

